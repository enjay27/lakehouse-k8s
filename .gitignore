# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

.idea

# macOS
.DS_Store

# Local secrets — env config files may contain credentials.
# Only common.yaml and *.example.yaml are tracked.
src/config/*.yaml
!src/config/common.yaml
!src/config/*.example.yaml

# Vendored RBAC helper libs
rbac/lib/

# Vendored OpenAPI documents (log-coverage/fetch_specs.sh). ASF-licensed, so
# committing them would be permitted -- they are excluded as downloads, not for
# licence reasons. `spec/inventory.json` records their sha256 and IS tracked.
log-coverage/spec/*.yml
log-coverage/spec/*.yaml
!log-coverage/spec/inventory.json

# The run's own report is regenerated by the notebook; the reviewed copy is
# committed by hand with the session's findings, not by a run.
log-coverage/doc-log-coverage-results-*.md
