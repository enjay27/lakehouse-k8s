# ============================================================
# Fluent Bit — K8s DaemonSet
# Collects Polaris pod logs → Docker OpenSearch on Mac
# OpenSearch: https://192.168.194.1:9200
# ============================================================

kind: DaemonSet

# ── Image ────────────────────────────────────────────────────
image:
  repository: cr.fluentbit.io/fluent/fluent-bit
  tag: "3.2.2"
  pullPolicy: IfNotPresent

# ── Service account ──────────────────────────────────────────
serviceAccount:
  create: true
  name: fluent-bit

rbac:
  create: true
  nodeAccess: true
  eventsAccess: true

# ── Resources ────────────────────────────────────────────────
resources:
  requests:
    memory: "64Mi"
    cpu: "50m"
  limits:
    memory: "256Mi"
    cpu: "200m"

# ── Tolerations: run on all nodes ───────────────────────────
tolerations:
  - key: node-role.kubernetes.io/master
    operator: Exists
    effect: NoSchedule
  - key: node-role.kubernetes.io/control-plane
    operator: Exists
    effect: NoSchedule

# ── Config ───────────────────────────────────────────────────
config:

  # ── Service ────────────────────────────────────────────────
  service: |
    [SERVICE]
        Flush         5
        Daemon        Off
        Log_Level     info
        Parsers_File  /fluent-bit/etc/parsers.conf
        Parsers_File  /fluent-bit/etc/conf/custom_parsers.conf
        HTTP_Server   On
        HTTP_Listen   0.0.0.0
        HTTP_Port     2020
        Health_Check  On

  # Simple tag: kube.* — works with kubernetes filter
  inputs: |
    [INPUT]
        Name              tail
        Path              /var/log/containers/*.log
        multiline.parser  docker, cri
        Tag               kube.*
        Refresh_Interval  5
        Mem_Buf_Limit     50MB
        Skip_Long_Lines   On
        DB                /var/log/flb_kube.db
        DB.sync           normal

  # ── Filters ────────────────────────────────────────────────
  filters: |
    # Enrich with K8s metadata
    [FILTER]
        Name                kubernetes
        Match               kube.*
        Kube_URL            https://kubernetes.default.svc:443
        Kube_CA_File        /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
        Kube_Token_File     /var/run/secrets/kubernetes.io/serviceaccount/token
        Kube_Tag_Prefix     kube.var.log.containers.
        Merge_Log           On
        Keep_Log            Off
        K8S-Logging.Parser  On
        K8S-Logging.Exclude On
        Annotations         Off
        Labels              On

    # Parse Polaris JSON logs
    [FILTER]
        Name         parser
        Match        kube.*
        Key_Name     log
        Parser       polaris_json
        Reserve_Data On

    # Add service metadata to all logs
    [FILTER]
        Name         record_modifier
        Match        kube.*
        Record       environment dev
        Record       cluster     datahub-hynix

    # Parse Polaris plain text format (fallback if JSON disabled)
    [FILTER]
        Name         parser
        Match        kube.*benchmarks-polaris*
        Key_Name     log
        Parser       polaris_text
        Reserve_Data On

  # ── Custom parsers ─────────────────────────────────────────
  customParsers: |
    # Polaris JSON format (logging.console.json: true)
    [PARSER]
        Name        polaris_json
        Format      json
        Time_Key    timestamp
        Time_Format %Y-%m-%dT%H:%M:%S.%L%z

    # Polaris plain text fallback
    [PARSER]
        Name        polaris_text
        Format      regex
        Regex       ^(?<timestamp>\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2},\d{3}) (?<level>[A-Z]+)\s+\[(?<logger>[^\]]+)\] \((?<thread>[^\)]+)\) \[(?<requestId>[^\]]*)\] (?<message>.+)$
        Time_Key    timestamp
        Time_Format %Y-%m-%d %H:%M:%S,%L

  # ── Output: Docker OpenSearch on Mac ──────────────────────
  outputs: |
    # Send ALL K8s logs to OpenSearch
    [OUTPUT]
        Name                opensearch
        Match               kube.*
        Host                192.168.194.1
        Port                9200
        HTTP_User           admin
        HTTP_Passwd         Str0ngP@ssw0rd123!
        Index               k8s-logs
        Type                _doc
        Logstash_Format     On
        Logstash_Prefix     k8s-logs
        Logstash_DateFormat %Y.%m.%d
        Time_Key            @timestamp
        Time_Key_Format     %Y-%m-%dT%H:%M:%S
        Include_Tag_Key     On
        Tag_Key             flb_tag
        Retry_Limit         3
        tls                 On
        tls.verify          Off
        Suppress_Type_Name  On

    # Send all other K8s logs to OpenSearch (optional — comment out if noisy)
    [OUTPUT]
        Name                opensearch
        Match               kube.*
        Host                192.168.194.1
        Port                9200
        HTTP_User           admin
        HTTP_Passwd         Str0ngP@ssw0rd123!
        Index               k8s-logs
        Type                _doc
        Logstash_Format     On
        Logstash_Prefix     k8s-logs
        Logstash_DateFormat %Y.%m.%d
        Retry_Limit         3
        tls                 On
        tls.verify          Off
        Suppress_Type_Name  On

# ── Liveness probe ───────────────────────────────────────────
livenessProbe:
  httpGet:
    path: /api/v1/health
    port: 2020
  initialDelaySeconds: 10
  periodSeconds: 10

# ── Readiness probe ──────────────────────────────────────────
readinessProbe:
  httpGet:
    path: /api/v1/health
    port: 2020
  initialDelaySeconds: 5
  periodSeconds: 10
