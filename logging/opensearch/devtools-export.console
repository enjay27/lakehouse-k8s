# =====================================================================================================
# OpenSearch Dev Tools — full-document JSON exports for the Polaris log pipeline
# =====================================================================================================
# Paste this whole file into OpenSearch Dashboards → Dev Tools. Put the cursor inside one request and
# press ▶ (Ctrl/Cmd+Enter). Copy the response panel into a .json file.
#
# Why not Discover → CSV: CSV keeps only the columns you picked (the v5 counters were missing), prints
# numbers with thousands separators ("1,898"), and flattens arrays (exception.frames) into strings.
# `_source` below is the document exactly as Fluent Bit indexed it — every field, original types.
#
# `filter_path` strips the search envelope so the response is just total + documents.
# Example values come from run 1789549828 (2026-09-16, report window 09:11:00Z). Change them:
#   WINDOW   window_start of the report row, UTC ("…Z")
#   EMIT     @timestamp of that window's SUMMARY row (from request 1 or 2)
#   RUN      the request-id prefix the traffic notebook sets: nb-<run>-
# Times written without a zone are read as KST because of "time_zone": "+09:00". Values ending in Z are UTC.
#
# Size limit: one response holds at most 10000 documents (index.max_result_window). More → request 10.
# Browser limit: a 10000-doc detail export with stack traces is tens of MB; for that use the curl form
# at the end of this file.
#
# String fields are dynamically mapped (text + .keyword, ignore_above 256): exact matches use `.keyword`.
# Numeric/date fields pinned by logging/opensearch/polaris-*-template.json are matched directly.
# =====================================================================================================


# ── 1. Which windows exist? Summary rows in a KST time range (small, to pick WINDOW / EMIT) ─────────────
GET polaris-report-*/_search?filter_path=hits.total,hits.hits._source
{
  "size": 500,
  "track_total_hits": true,
  "query": {
    "bool": {
      "filter": [
        { "term": { "report_type.keyword": "summary" } },
        { "range": { "window_start": { "gte": "2026-09-16T18:00:00", "lt": "2026-09-16T19:00:00", "time_zone": "+09:00" } } }
      ]
    }
  },
  "_source": [ "@timestamp", "window_start", "window_end", "report_seq", "hostname", "schema_version",
               "access_seen", "access_kept", "access_counted", "counted_404", "app_dropped_404",
               "errors_4xx", "errors_5xx", "held_orphans", "held_pending", "_msg" ],
  "sort": [ { "window_start": "asc" } ]
}


# ── 2. One report window, ALL rows (summary, resource, principal, app_dropped), full documents ─────────
GET polaris-report-*/_search?filter_path=hits.total,hits.hits._index,hits.hits._id,hits.hits._source
{
  "size": 10000,
  "track_total_hits": true,
  "query": {
    "bool": {
      "filter": [
        { "term": { "window_start": "2026-09-16T09:11:00Z" } }
      ]
    }
  },
  "sort": [
    { "report_type.keyword": { "order": "desc" } },
    { "resource.keyword": { "order": "asc", "missing": "_last" } },
    { "user_principal_name.keyword": { "order": "asc", "missing": "_last" } },
    { "logger_name.keyword": { "order": "asc", "missing": "_last" } }
  ]
}
# On a multi-pod cluster add to "filter":  { "term": { "hostname.keyword": "benchmarks-fluent-bit-fjdjb" } }
# report_type desc = summary, resource, principal, app_dropped.


# ── 3. Detail docs (polaris-logs-*) that one report row counted — full documents ─────────────────────
# NOT window_start..window_end: a row holds the records between the tick that closed the previous window
# and the tick that closed this one (#26) = [EMIT - window_seconds, EMIT). Paste EMIT twice.
GET polaris-logs-*/_search?filter_path=hits.total,hits.hits._index,hits.hits._id,hits.hits._source
{
  "size": 10000,
  "track_total_hits": true,
  "query": {
    "range": { "@timestamp": { "gte": "2026-09-16T09:11:30.321Z||-30s", "lt": "2026-09-16T09:11:30.321Z" } }
  },
  "sort": [ { "@timestamp": "asc" }, { "sequence": { "order": "asc", "missing": "_last" } } ]
}


# ── 4. Tier-1 raw copy (k8s-logs-*) of the same interval — the unfiltered Polaris records ─────────────
# This is what step11 replays through the Lua. Polaris records are the ones with `sequence` + `loggerName`.
GET k8s-logs-*/_search?filter_path=hits.total,hits.hits._index,hits.hits._id,hits.hits._source
{
  "size": 10000,
  "track_total_hits": true,
  "query": {
    "bool": {
      "filter": [
        { "exists": { "field": "sequence" } },
        { "exists": { "field": "loggerName" } },
        { "range": { "@timestamp": { "gte": "2026-09-16T09:11:30.321Z||-30s", "lt": "2026-09-16T09:11:30.321Z" } } }
      ]
    }
  },
  "sort": [ { "sequence": "asc" } ]
}
# Smaller file: add  "_source": { "excludes": [ "kubernetes.labels*", "kubernetes.annotations*" ] }


# ── 5. A whole traffic run by request-id prefix — stored detail docs, access + app lines together ─────
GET polaris-logs-*/_search?filter_path=hits.total,hits.hits._index,hits.hits._id,hits.hits._source
{
  "size": 10000,
  "track_total_hits": true,
  "query": {
    "prefix": { "mdc.requestId.keyword": "nb-1789549828-" }
  },
  "sort": [ { "mdc.requestId.keyword": "asc" }, { "@timestamp": "asc" } ]
}


# ── 6. One request end to end — detail doc(s) AND its tier-1 original ────────────────────────────────
GET polaris-logs-*,k8s-logs-*/_search?filter_path=hits.total,hits.hits._index,hits.hits._id,hits.hits._source
{
  "size": 100,
  "query": {
    "term": { "mdc.requestId.keyword": "nb-1789549828-2245-getToken-400" }
  },
  "sort": [ { "@timestamp": "asc" } ]
}


# ── 7. Errors with full stack traces (exception.frames) in a KST range — #24 material ───────────────
GET polaris-logs-*/_search?filter_path=hits.total,hits.hits._index,hits.hits._id,hits.hits._source
{
  "size": 1000,
  "track_total_hits": true,
  "query": {
    "bool": {
      "filter": [
        { "range": { "@timestamp": { "gte": "2026-09-16T18:10:00", "lt": "2026-09-16T18:12:00", "time_zone": "+09:00" } } }
      ],
      "should": [
        { "term": { "level.keyword": "ERROR" } },
        { "range": { "http_status": { "gte": 500 } } },
        { "exists": { "field": "exception" } }
      ],
      "minimum_should_match": 1
    }
  },
  "sort": [ { "@timestamp": "asc" } ]
}


# ── 8. Checks, no documents ──────────────────────────────────────────────────────────────────────────
# 8a. 404 policy: stored 404 access docs since a time (expect 0 after v5)
GET polaris-logs-*/_count
{
  "query": { "bool": { "filter": [
    { "term": { "http_status": 404 } },
    { "range": { "@timestamp": { "gte": "2026-09-16T08:36:00Z" } } }
  ] } }
}

# 8b. Detail docs per logger in the interval of request 3 (compare with the report's access_kept)
GET polaris-logs-*/_search?filter_path=hits.total,aggregations
{
  "size": 0,
  "track_total_hits": true,
  "query": { "range": { "@timestamp": { "gte": "2026-09-16T09:11:30.321Z||-30s", "lt": "2026-09-16T09:11:30.321Z" } } },
  "aggs": {
    "by_logger": { "terms": { "field": "loggerName.keyword", "size": 50 } },
    "by_status": { "terms": { "field": "http_status", "size": 50 } }
  }
}

# 8c. Field types the exports depend on (text vs long vs date, per daily index)
GET polaris-report-*/_mapping/field/window_start,report_seq,counted_404,app_dropped_404,held_orphans,held_pending,min_record_time
GET polaris-logs-*/_mapping/field/http_status,response_size,sequence,_time,mdc.requestId,exception.frames


# ── 9. Every summary row of a day, full documents (trend exports) ───────────────────────────────────
GET polaris-report-*/_search?filter_path=hits.total,hits.hits._index,hits.hits._id,hits.hits._source
{
  "size": 10000,
  "track_total_hits": true,
  "query": { "bool": { "filter": [
    { "term": { "report_type.keyword": "summary" } },
    { "range": { "window_start": { "gte": "2026-09-16T00:00:00", "lt": "2026-09-17T00:00:00", "time_zone": "+09:00" } } }
  ] } },
  "sort": [ { "window_start": "asc" }, { "hostname.keyword": "asc" } ]
}


# ── 10. More than 10000 documents: point in time + search_after (repeat 10b per page) ────────────────
# 10a. open a PIT; copy "pit_id" from the response
POST polaris-logs-*/_search/point_in_time?keep_alive=10m

# 10b. first page: no search_after. Next pages: add  "search_after": <the "sort" array of the LAST hit>
#      (filter_path keeps hits.hits.sort for that reason)
GET _search?filter_path=hits.hits._index,hits.hits._id,hits.hits._source,hits.hits.sort,pit_id
{
  "size": 10000,
  "pit": { "id": "PASTE_PIT_ID", "keep_alive": "10m" },
  "query": {
    "range": { "@timestamp": { "gte": "2026-09-16T00:00:00", "lt": "2026-09-17T00:00:00", "time_zone": "+09:00" } }
  },
  "sort": [ { "@timestamp": "asc" }, { "sequence": { "order": "asc", "missing": "_last" } } ]
}
# Tie-breaker: Polaris `sequence` (unique per Polaris process). Report rows share one @timestamp and have no
# sequence — page those by window instead (request 2 per window). Not yet run on 3.5.0: if the PIT search
# rejects the body, send the error to Claude rather than dropping the tie-breaker.

# 10c. close it
DELETE _search/point_in_time
{
  "pit_id": [ "PASTE_PIT_ID" ]
}


# ── curl form: same bodies, straight to a file (no browser size limit) ─────────────────────────────
#   export OS_URL=https://192.168.194.1:9200 OS_USER=admin OS_PASSWORD='...'
#   curl -sk -u "$OS_USER:$OS_PASSWORD" -H 'Content-Type: application/json' \
#     "$OS_URL/polaris-logs-*/_search?filter_path=hits.hits._source" -d @query.json \
#     | python3 -c 'import json,sys; json.dump([h["_source"] for h in json.load(sys.stdin)["hits"]["hits"]], sys.stdout, ensure_ascii=False, indent=1)' \
#     > detail.json
#   (query.json = the JSON body of any request above.) The output is a plain array of documents — the
#   same shape as .scratch/readout-*/detail.json, so step11 and Claude can read it directly.
